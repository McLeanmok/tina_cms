---
import type { CollectionEntry } from "astro:content";

type Props = {
  content: CollectionEntry<"articles">;
};

const { content } = Astro.props as Props;
const { title, lede, date } = content.data;
---

<article class="article-card">
  <h2 class="article-card__heading">{title}</h2>
  <time datetime={date.toISOString()} class="article-card__date">
    {date.toLocaleDateString(undefined, {
      dateStyle: "medium",
      timeZone: "UTC",
    })}
  </time>
  <p class="article-card__lede">{lede}</p>
  <a href={`/blog/${content.id}`} class="standard-btn article-card__link" data-btn="true">Read article</a>
</article>